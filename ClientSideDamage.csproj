<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build with the .NET SDK:  dotnet build -c Release
    Reference assemblies come straight from the game install and BepInEx\core.
    Override the paths with the CSD_GAME_DIR / CSD_BEPINEX_CORE environment variables
    (build.ps1 sets them for you).
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ClientSideDamage</AssemblyName>
    <RootNamespace>ClientSideDamage</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <OutputPath>dist</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>CS1701;CS1702</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <GameDir Condition="'$(CSD_GAME_DIR)' != ''">$(CSD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\Sephiria</GameDir>
    <Managed>$(GameDir)\Sephiria_Data\Managed</Managed>
    <BepInExCore Condition="'$(CSD_BEPINEX_CORE)' != ''">$(CSD_BEPINEX_CORE)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(Managed)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(Managed)\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror.Components"><HintPath>$(Managed)\Mirror.Components.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
